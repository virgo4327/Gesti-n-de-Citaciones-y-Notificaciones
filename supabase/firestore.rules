rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ ADVERTENCIA: Sin autenticación de usuarios, estas reglas permiten
    // lectura y escritura a cualquiera que tenga tu projectId y apiKey.
    // Para producción real, implementa Firebase Authentication o App Check.
    match /diligencias/{document=**} {
      allow read, write: if true;
    }
  }
}